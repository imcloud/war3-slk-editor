{
  "name": "war3-slk-editor",
  "publisher": "imcloud",
  "displayName": "Warcraft III SLK Editor",
  "description": "Visual spreadsheet editor for Warcraft III map .slk files",
  "version": "1.1.3",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/imcloud/war3-slk-editor.git"
  },
  "bugs": {
    "url": "https://github.com/imcloud/war3-slk-editor/issues"
  },
  "homepage": "https://github.com/imcloud/war3-slk-editor#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "warcraft",
    "war3",
    "slk",
    "editor",
    "spreadsheet",
    "map-making",
    "w3x"
  ],
  "activationEvents": [
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "slk",
        "extensions": [
          ".slk"
        ],
        "aliases": [
          "SLK File",
          "slk"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "war3.slkEditor",
        "displayName": "WAR3 SLK编辑器",
        "selector": [
          {
            "filenamePattern": "*.slk"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  }
}