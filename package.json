{
  "name": "war3-slk-editor",
  "publisher": "imcloud",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.2.3",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/imcloud/war3-slk-editor.git"
  },
  "bugs": {
    "url": "https://github.com/imcloud/war3-slk-editor/issues"
  },
  "homepage": "https://github.com/imcloud/war3-slk-editor#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "warcraft",
    "war3",
    "slk",
    "editor",
    "spreadsheet",
    "map-making",
    "w3x"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "slk",
        "extensions": [
          ".slk"
        ],
        "aliases": [
          "SLK File",
          "slk"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "war3.slkEditor",
        "displayName": "%editor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.slk"
          }
        ],
        "priority": "default"
      }
    ],
    "configuration": {
      "title": "WAR3 SLK Editor",
      "properties": {
        "war3Slk.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh",
            "en"
          ],
          "default": "auto",
          "description": "%config.language.description%"
        },
        "war3Slk.focusOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%config.focusOnOpen.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node tests/gridOps.test.js && node tests/parser-contract.test.js && node tests/provider.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.0.0"
  }
}
